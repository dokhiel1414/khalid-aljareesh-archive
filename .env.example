# --- Database (Vercel Postgres / Supabase / Neon) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Used by Supabase / Neon pooling. If not applicable, set the same as DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# --- Admin credentials (single admin) ---
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-to-a-strong-password"

# --- JWT signing secret (any long random string) ---
# Generate: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-string-min-32-chars"

# --- Public site URL (optional) ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
